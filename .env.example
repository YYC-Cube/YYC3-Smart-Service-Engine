# ===========================================
# YYC³ AI Bot - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# -------------------------------------------
# Application Configuration
# -------------------------------------------

# Application name (used for display and logging)
NEXT_PUBLIC_APP_NAME=YYC³ AI Bot

# Environment (development, staging, production)
NODE_ENV=development

# Base URL for the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# AI Service Configuration
# -------------------------------------------

# OpenAI API Key (for GPT-4, GPT-3.5, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL (if using a proxy or custom endpoint)
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# AI Model to use (gpt-4, gpt-3.5-turbo, etc.)
OPENAI_MODEL=gpt-4

# Maximum tokens for AI responses
OPENAI_MAX_TOKENS=2000

# Temperature for AI responses (0.0 - 2.0)
OPENAI_TEMPERATURE=0.7

# -------------------------------------------
# Text-to-Speech (TTS) Configuration
# -------------------------------------------

# TTS Provider (browser-native, openai, google)
TTS_PROVIDER=browser-native

# Google Cloud TTS API Key (if using Google TTS)
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Default voice settings
TTS_DEFAULT_RATE=1.0
TTS_DEFAULT_PITCH=1.0
TTS_DEFAULT_VOLUME=1.0

# -------------------------------------------
# Speech Recognition (ASR) Configuration
# -------------------------------------------

# ASR Provider (browser-native, openai-whisper, google)
ASR_PROVIDER=browser-native

# Language code for speech recognition (zh-CN, en-US, etc.)
ASR_LANGUAGE=zh-CN

# Continuous speech recognition mode
ASR_CONTINUOUS=true

# Timeout for speech recognition in milliseconds
ASR_TIMEOUT=60000

# -------------------------------------------
# Image Generation Configuration
# -------------------------------------------

# Image generation provider (dall-e, stable-diffusion, midjourney-api)
IMAGE_GENERATION_PROVIDER=dall-e

# DALL-E API Key (if different from OpenAI key)
# DALLE_API_KEY=your_dalle_api_key_here

# Default image size (256x256, 512x512, 1024x1024)
IMAGE_DEFAULT_SIZE=512x512

# Image quality (standard, hd)
IMAGE_QUALITY=standard

# Number of images to generate per request
IMAGE_COUNT=1

# -------------------------------------------
# Database Configuration
# -------------------------------------------

# Database URL (PostgreSQL, MySQL, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/yyc3_bot

# Redis URL (for caching and session management)
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# Authentication & Security
# -------------------------------------------

# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# Session secret for encryption
SESSION_SECRET=your_session_secret_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100

# -------------------------------------------
# Logging & Monitoring
# -------------------------------------------

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# Analytics ID (Google Analytics, Plausible, etc.)
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# -------------------------------------------
# Feature Flags
# -------------------------------------------

# Enable digital human feature
ENABLE_DIGITAL_HUMAN=true

# Enable customer service chatbot
ENABLE_CUSTOMER_SERVICE=true

# Enable text-to-image generation
ENABLE_TEXT_TO_IMAGE=true

# Enable voice interaction
ENABLE_VOICE_INTERACTION=true

# Enable analytics dashboard
ENABLE_ANALYTICS=true

# -------------------------------------------
# External Services (Optional)
# -------------------------------------------

# Email service (sendgrid, mailgun, aws-ses)
EMAIL_SERVICE_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@yyc3.com

# File storage (local, s3, gcs, azure-blob)
FILE_STORAGE_PROVIDER=local
# AWS S3 Bucket (if using S3)
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# CDN URL (optional, for serving static assets)
# CDN_URL=https://cdn.yyc3.com

# -------------------------------------------
# Development Settings
# -------------------------------------------

# Enable hot reload in development
NEXT_PUBLIC_DEV_MODE=true

# Port for development server (default: 3000)
PORT=3000

# Enable mock data for development without real APIs
USE_MOCK_DATA=false

# Debug AI responses (show raw API calls)
DEBUG_AI_RESPONSES=false
