# ============================================
# YYC³ Smart Service Engine - Environment Variables
# ============================================
# Copy this file to .env.local for local development

# 🌐 Application Configuration
NEXT_PUBLIC_APP_NAME="YYC³ Smart Service Engine"
NEXT_PUBLIC_APP_URL=https://sse.yyc3.top
NEXT_PUBLIC_APP_VERSION=3.0.0

# 🔐 Security Configuration (if using NextAuth)
# Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=https://sse.yyc3.top

# 🤖 AI Service Configuration (Optional)
# OPENAI_API_KEY=sk-your_openai_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# 🔧 Feature Flags
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_TTS=true
NEXT_PUBLIC_ENABLE_IMAGE_GENERATION=true
NEXT_PUBLIC_ENABLE_DIGITAL_HUMAN=true

# 🎨 UI Configuration
NEXT_PUBLIC_THEME=default
NEXT_PUBLIC_PRIMARY_COLOR=#3B82F6

# 🌍 Localization
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_SUPPORTED_LOCALES=zh-CN,en-US,ja-JP
